# ZenPTai — variáveis de ambiente
# Copie este ficheiro para .env na pasta de dados da app no Umbrel.

# Porta interna da aplicação (não alterar)
NODE_ENV=production

# Banco de dados
POSTGRES_PASSWORD=coloque_aqui_a_senha_do_postgres
DATABASE_URL=postgresql://zenuser:coloque_aqui_a_senha_do_postgres@db:5432/zenpt

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=phi3

# Segredo JWT — gere um valor único e longo
JWT_SECRET=coloque_aqui_um_segredo_jwt_longo_e_aleatorio

# Google OAuth (obtém no Google Cloud Console)
GOOGLE_CLIENT_ID=vai_buscar_ao_google_console
GOOGLE_CLIENT_SECRET=vai_buscar_ao_google_console

# URL pública para callbacks OAuth (ex: https://zenpt.ileve.com.pt/api/auth/google/callback)
GOOGLE_REDIRECT_URI=https://SEU_DOMINIO_CLOUDFLARE.pt/api/auth/google/callback

# SSL — defina false se usar Cloudflare Tunnel (recomendado)
USE_HTTPS=false
SSL_CERT_PATH=/app/certs/ileve.com.pt.pem
SSL_KEY_PATH=/app/certs/ileve.com.pt.key
