# FocusTime — variáveis de ambiente
# Copie este ficheiro para .env e preencha os valores antes de instalar a app.

# Porta interna da aplicação (não alterar)
PORT=3030
NODE_ENV=production

# Segredo JWT — gere um valor único e longo (ex: openssl rand -hex 32)
JWT_SECRET=coloque_aqui_um_segredo_jwt_longo_e_aleatorio

# Senha do PostgreSQL
POSTGRES_PASSWORD=coloque_aqui_a_senha_do_postgres

# URL pública da app (usada para callbacks OAuth e links)
# Exemplo: https://focustime.ileve.com.pt
APP_URL=https://SEU_DOMINIO_CLOUDFLARE.pt

# Google OAuth (obtém no Google Cloud Console)
GOOGLE_CLIENT_ID=vai_buscar_ao_google_console
GOOGLE_CLIENT_SECRET=vai_buscar_ao_google_console

# Gemini AI (opcional)
GEMINI_API_KEY=sua_chave_gemini_aqui
